{
  "name": "@tacticocc/jevbridge",
  "version": "0.2.0",
  "description": "ACP and MCP adapter that bridges TypeSafe Jev with any LLM for computer use and typed decisions.",
  "type": "module",
  "license": "MIT",
  "bin": {
    "jevbridge": "./bin/jevbridge.mjs"
  },
  "exports": {
    ".": "./src/index.ts"
  },
  "files": [
    "src",
    "bin",
    "skills",
    "examples",
    "brand",
    "LICENSE",
    "README.md"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/tacticocc/Jevbridge.git"
  },
  "homepage": "https://github.com/tacticocc/Jevbridge",
  "bugs": {
    "url": "https://github.com/tacticocc/Jevbridge/issues"
  },
  "publishConfig": {
    "access": "public"
  },
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "mcp": "node --experimental-strip-types src/cli.ts mcp",
    "acp": "node --experimental-strip-types src/cli.ts acp",
    "eval": "node --experimental-strip-types src/cli.ts eval",
    "test": "node --experimental-strip-types --test src/*.test.ts src/**/*.test.ts",
    "prepublishOnly": "node --experimental-strip-types --test src/*.test.ts src/**/*.test.ts"
  },
  "keywords": [
    "jev",
    "typesafe",
    "mcp",
    "acp",
    "llm",
    "computer-use",
    "agent",
    "codex",
    "claude",
    "grok",
    "opencode"
  ]
}
